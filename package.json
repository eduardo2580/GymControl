{
  "name": "gymcontrol",
  "version": "2.0.0",
  "description": "Sistema de Gerenciamento de Academia com SQLite",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "lint": "eslint . --ext .js --ignore-pattern node_modules --ignore-pattern public/vendor --ignore-pattern test-results --ignore-pattern playwright-report",
    "test": "jest --runInBand --forceExit",
    "test:e2e": "playwright test",
    "test:e2e:human": "playwright test && node scripts/clean-results.js && playwright test --config=playwright.config.human.js && node scripts/concat-e2e-video.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 15000,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/e2e/"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "eslint": "^9.0.0",
    "ffmpeg-static": "^5.3.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.11.0"
  }
}
