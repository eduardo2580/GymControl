# ─── Backend (server.js) ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# JWT secret. MUST be set (and not the default) when NODE_ENV=production —
# server.js has a guard that exits if NODE_ENV=production && JWT_SECRET=dev-secret-change-me.
JWT_SECRET=change-me-in-production

# MySQL — matches docker-compose.yml defaults for local dev.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=gymcontrol

# ─── E2E (Playwright) ─────────────────────────────────────────────────────
# Point at a deployed env to skip the local webServer; leave unset for local runs.
# E2E_BASE_URL=https://gym.example.com

# ─── Deploy hint ──────────────────────────────────────────────────────────
# When the AWS backend is live, add a "rewrites" block to vercel.json:
#
#   "rewrites": [
#     { "source": "/api/(.*)", "destination": "https://<your-aws-host>/api/$1" }
#   ]
#
# The cookie is httpOnly + SameSite=Strict, so frontend and API need a
# shared parent domain (e.g. gymcontrol.com + api.gymcontrol.com).
